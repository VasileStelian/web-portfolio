---
import type { CollectionEntry } from 'astro:content';
import AchievementList from './AchievementList.astro';

interface Props {
  role: CollectionEntry<'experience'>;
}

const { role } = Astro.props;
const { data } = role;
---
<article class="mt-11 border-t border-line pt-8 first:mt-0 first:border-t-0 first:pt-0">
  <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
    <h3 class="font-display text-xl font-bold tracking-tight">{data.title}</h3>
    <span class="mono-label text-fg-faint">{data.period}</span>
  </div>

  <p class="mt-1 font-mono text-xs text-meta">
    {data.employer}{data.mode ? ` · ${data.mode}` : ''}
  </p>

  <AchievementList items={data.highlights} />
</article>
