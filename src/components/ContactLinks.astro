---
import { CONTACT, SOCIAL } from '../config/site';

const links = [
  { label: CONTACT.email, href: `mailto:${CONTACT.email}` },
  { label: CONTACT.phoneDisplay, href: `tel:${CONTACT.phone}` },
  { label: 'GitHub', href: SOCIAL.github },
  { label: 'LinkedIn', href: SOCIAL.linkedin },
];
---
<ul class="flex list-none flex-wrap gap-x-6 gap-y-2 p-0 font-mono text-sm">
  {links.map((link) => (
    <li>
      <a href={link.href} class="border-b border-line pb-0.5 text-fg no-underline hover:border-accent hover:text-accent">
        {link.label}
      </a>
    </li>
  ))}
</ul>
