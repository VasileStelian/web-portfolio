---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeader from '../components/SectionHeader.astro';
import ProjectCard from '../components/ProjectCard.astro';
import RoleCard from '../components/RoleCard.astro';
import ContactLinks from '../components/ContactLinks.astro';
import { PERSON, SOCIAL, CV_PATH } from '../config/site';
import { CV_EDUCATION } from '../config/cv';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const roles = (await getCollection('experience')).sort((a, b) => a.data.order - b.data.order);

const heroLinks = [
  { label: 'Projects', href: '#projects' },
  { label: 'GitHub', href: SOCIAL.github },
  { label: 'LinkedIn', href: SOCIAL.linkedin },
  { label: 'CV', href: CV_PATH },
];
---
<BaseLayout
  title={`${PERSON.name} — ${PERSON.role}`}
  description="Full-stack developer. Software Developer on the OptimumDesk platform at Startech Team since October 2026, working in PHP, React, TypeScript and Go, and building my own products alongside."
>
  <section class="pt-14 pb-4">
    <h1 class="font-display text-[clamp(2.4rem,7vw,4rem)] leading-[0.98] font-black tracking-[-0.03em] text-balance">
      Sofron<br />Vasile-Stelian
    </h1>
    <p class="mono-label mt-4 text-accent">Full-stack developer</p>
    <p class="mt-6 max-w-[34rem] text-fg-muted">
      I build things that run in production and I can tell you why every decision in them
      was made. Since October 2026 I have been a software developer on the OptimumDesk
      platform at Startech Team, and I build my own products alongside it.
    </p>
    <ul class="mt-8 flex list-none flex-wrap gap-x-6 gap-y-2 p-0">
      {heroLinks.map((link) => (
        <li>
          <a href={link.href} class="mono-label border-b border-accent pb-0.5 text-fg no-underline hover:text-accent">
            {link.label}
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section class="pt-16" aria-labelledby="about">
    <SectionHeader title="About" id="about" />
    <div class="flex max-w-[44rem] flex-col gap-5 text-fg-muted">
      <p>
        I started in first-line support, answering phones and diagnosing problems from
        nothing but a description. That taught me to ask better questions. Onsite work came
        next, where I finally had access to the systems and logs behind an application, and I
        started tracing problems to their cause instead of passing them on. That is what
        pushed me toward building rather than only fixing.
      </p>
      <p>
        At Startech Team I started on internal tools and automation, and in March 2026 I
        took over development of sigurantapenet.ro, a Laravel platform other people had
        built, which had to keep running while I changed it. Since October 2026 I have
        worked on the OptimumDesk platform: PHP and Symfony on the API, React and
        TypeScript in the portal, and Go in the agents that run on client machines. In the
        first five weeks that came to 201 merged pull requests, including the platform's
        XDR module.
      </p>
      <p>
        I build with an eye on failure modes and concurrency, I test end to end, and I write
        down the decisions I make, including the ones where I chose not to build something. I
        would rather find the gap myself than have someone else find it in production.
      </p>
      <p class="font-mono text-xs text-meta">
        Currently: PHP (Laravel, Symfony), TypeScript, React and Next.js, Go, MySQL,
        PostgreSQL and Oracle, Docker and Linux.<br />
        Currently learning: going deeper on performance and on the parts of the stack I have
        only used, not understood.
      </p>
    </div>
  </section>

  <section class="pt-16" aria-labelledby="projects">
    <SectionHeader title="Projects" id="projects" />
    {projects.map((project) => <ProjectCard project={project} />)}
  </section>

  <section class="pt-16" aria-labelledby="experience">
    <SectionHeader title="Experience" id="experience" />
    {roles.map((role) => <RoleCard role={role} />)}
  </section>

  <section class="pt-16" aria-labelledby="education">
    <SectionHeader title="Education" id="education" />
    <ul class="flex list-none flex-col gap-4 p-0">
      {CV_EDUCATION.map((row) => (
        <li class="achievement">
          <span class="achievement__label">{row.label}</span>
          <p class="achievement__text">{row.text}</p>
        </li>
      ))}
    </ul>
  </section>

  <section class="pt-16" aria-labelledby="contact">
    <SectionHeader title="Contact" id="contact" />
    <p class="mb-6 max-w-[44rem] text-fg-muted">
      Open to backend and full-stack roles — remote, Iași or Bacău, and open to relocating.
    </p>
    <ContactLinks />
  </section>
</BaseLayout>
